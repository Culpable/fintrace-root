{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fintrace-root",
  "account_id": "213ab3604485056376263d22fa242742",
  "compatibility_date": "2026-09-05",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      // Staging only until the approved cutover adds the apex. Removed again
      // once production checks pass (plan Step 9).
      "pattern": "staging.fintrace.com.au",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/*.avif",
      "!/*.css",
      "!/*.gif",
      "!/*.ico",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.js",
      "!/*.json",
      "!/*.map",
      "!/*.mjs",
      "!/*.pdf",
      "!/*.png",
      "!/*.svg",
      "!/*.txt",
      "!/*.webmanifest",
      "!/*.webp",
      "!/*.woff",
      "!/*.woff2",
      "!/*.xml"
    ]
  },
  "env": {
    "preview": {
      "name": "fintrace-root-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": []
    }
  }
}

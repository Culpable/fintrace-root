{
  "name": "fintrace-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "precheck": "wrangler types",
    "check": "astro check",
    "prebuild": "wrangler types",
    "build": "astro check && astro build && node scripts/generate-agent-markdown.mjs dist https://fintrace.com.au",
    "preview": "astro preview",
    "preview:static": "node scripts/preview-server.mjs",
    "test": "pnpm test:unit && pnpm test:build-output && playwright test",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts",
    "test:build-output": "node scripts/validate-build.mjs && node scripts/report-performance-budgets.mjs && node scripts/verify-trust-pages.mjs",
    "test:e2e": "playwright test",
    "test:agent-a11y": "playwright test test/agent-accessibility.spec.ts",
    "test:http": "node scripts/run-http-contract.mjs",
    "test:hosted-analytics": "node scripts/verify-hosted-analytics.mjs",
    "test:hosted-browser": "node scripts/verify-hosted-browser.mjs",
    "report:lighthouse:matrix": "node scripts/run-lighthouse-matrix.mjs",
    "capture:production": "node scripts/capture-production-parity.mjs",
    "worker:dev": "wrangler dev",
    "worker:types": "wrangler types",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:preview": "wrangler versions upload --env preview"
  },
  "dependencies": {
    "astro": "7.3.1",
    "mixpanel-browser": "2.81.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.13",
    "@types/three": "0.182.0",
    "parse5": "8.0.1",
    "pixelmatch": "7.2.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  }
}

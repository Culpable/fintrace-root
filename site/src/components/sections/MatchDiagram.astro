---
import type { MatchLayout } from '@/data/currency-match.ts'

/**
 * One layout of the cross-currency match diagram.
 *
 * Ids are prefixed `ecmnet-` and suffixed per layout because SVG paint-server
 * and clip ids resolve document-wide: both SVGs are in the DOM at all times and
 * must never collide.
 */
interface Props {
  layout: MatchLayout
}

const { layout }: Props = Astro.props
const { chip, beam, plate, link, key } = layout
const windowId = `ecmnet-window-${key}`
const beamId = `ecmnet-beam-${key}`
---

<svg
  class={`ecm ecm-${layout.variant}`}
  viewBox={layout.viewBox}
  role="img"
  aria-label="An Australian dollar transfer matched to a euro deposit through an international money transfer"
>
  <defs>
    {/* Window the rolling amounts and the sweep are clipped to, so both
        read as motion inside the chip rather than loose SVG text */}
    <clipPath id={windowId}>
      <rect x={chip.x} y={chip.y} width={chip.w} height={chip.h} rx="3" />
    </clipPath>

    {/* Soft gold beam: transparent at both edges so the sweep reads as
        light travelling across the plate, not a bar sliding over it */}
    <linearGradient id={beamId} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#f0d491" stop-opacity="0" />
      <stop offset="45%" stop-color="#f0d491" stop-opacity="0.62" />
      <stop offset="55%" stop-color="#fff6e0" stop-opacity="0.78" />
      <stop offset="100%" stop-color="#f0d491" stop-opacity="0" />
    </linearGradient>
  </defs>

  {/* Leg one: dollars. Recessed gold — the trail before the swap */}
  <path class="ecm-path ecm-path-aud" d={layout.legAud} fill="none" />

  {/* Leg two: euros. Bright gold — the same funds, now converted */}
  <path class="ecm-path ecm-path-eur" d={layout.legEur} fill="none" />

  {layout.stations.map((station) => (
    <g class="ecm-st">
      {station.ping && (
        <circle class={`ecm-ping ecm-ping-${station.ping}`} cx={station.cx} cy={layout.nodeY} r="9" />
      )}
      <circle class="ecm-ring" cx={station.cx} cy={layout.nodeY} r="9" />
      <circle class="ecm-dot" cx={station.cx} cy={layout.nodeY} r="4.5" />

      {station.nameLines.map((line, index) => (
        <text
          class="ecm-name"
          
          x={station.cx}
          y={layout.nameY + index * layout.nameGap}
          text-anchor="middle"
        >
          {line}
        </text>
      ))}

      {station.subLines.map((line, index) => (
        <text
          class:list={['ecm-sub', station.subClass]}
          
          x={station.cx}
          y={layout.subY + index * layout.subGap}
          text-anchor="middle"
        >
          {line}
        </text>
      ))}
    </g>
  ))}

  {/* The travelling amount chip: dollars out, euros in */}
  <g class="ecm-chip">
    {/* Unmatched plate: dark fill, champagne rule */}
    <rect class="ecm-box ecm-box-aud" x={chip.x} y={chip.y} width={chip.w} height={chip.h} rx="3" />
    {/* Matched plate: gold wash, bright rule — cross-faded in on conversion */}
    <rect class="ecm-box ecm-box-eur" x={chip.x} y={chip.y} width={chip.w} height={chip.h} rx="3" />

    <g clip-path={`url(#${windowId})`}>
      <text class="ecm-amt ecm-amt-aud" x="0" y={chip.y + chip.h / 2 + 5} text-anchor="middle">
        A$28,000
      </text>
      <text class="ecm-amt ecm-amt-eur" x="0" y={chip.y + chip.h / 2 + 5} text-anchor="middle">
        €16,800
      </text>
      <rect
        class="ecm-beam"
        x={beam.x}
        y={chip.y}
        width={beam.w}
        height={chip.h}
        fill={`url(#${beamId})`}
      />
    </g>
  </g>

  {/* Verdict: the one green in the system, fired on the same frame as the
      destination ping and tied to the chip by its own hairline */}
  <g class="ecm-match">
    <line class="ecm-link" x1={link.x} y1={link.y1} x2={link.x} y2={link.y2} />
    <rect class="ecm-match-fill" x={plate.x} y={plate.y} width={plate.w} height={plate.h} rx="2" />
    {/* pathLength normalises the perimeter to 100 so one dash keyframe draws
        the rule closed at any plate width — the flagged ledger row's technique */}
    <rect
      class="ecm-match-rule"
      x={plate.x}
      y={plate.y}
      width={plate.w}
      height={plate.h}
      rx="2"
      pathLength="100"
    />
    <text class="ecm-match-text" x={plate.x + plate.w / 2} y={plate.textY} text-anchor="middle">
      MATCHED
    </text>
  </g>
</svg>

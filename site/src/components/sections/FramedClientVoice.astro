---
import Reveal from '@/components/elements/Reveal.astro'
import { NICK_TESTIMONIAL } from '@/data/testimonial.ts'

/**
 * Renders the selected testimonial treatment in production.
 *
 * Callers pass the slice they carry, because the two approved paragraphs are
 * split between the homepage and About so no sentence appears on both.
 *
 * It carries no `.eng-plate`: the quote's own ruled aperture is its frame, and
 * the page's one human voice should not arrive in the same engraved case as
 * the outcome and engagement plates it now sits between.
 */
interface Props {
  /** Slice of the approved testimony to render; defaults to the full wording. */
  paragraphs?: readonly string[]
}

const { paragraphs = NICK_TESTIMONIAL.paragraphs } = Astro.props
---

<Reveal class="eng-client-frame" delay={0}>
  <div class="eng-client-frame-wrap eng-client-frame-final">
    <p class="eng-kicker">{NICK_TESTIMONIAL.eyebrow}</p>
    <blockquote class="eng-client-frame-quote">
      <span class="eng-client-frame-mark eng-client-frame-mark-open" aria-hidden="true">“</span>
      <div class="eng-client-frame-copy">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <span class="eng-client-frame-mark eng-client-frame-mark-close" aria-hidden="true">”</span>
    </blockquote>
    <div class="eng-client-frame-rule" aria-hidden="true"></div>
    <div class="eng-client-frame-attribution">
      <span class="eng-client-frame-photo eng-client-voice-duo eng-client-voice-grain">
        <img
          src="/images/testimonial/nick-brookes.png"
          alt={NICK_TESTIMONIAL.name}
          width="58"
          height="58"
          loading="lazy"
          decoding="async"
        />
      </span>
      <span>
        <span class="eng-client-frame-name">{NICK_TESTIMONIAL.name}</span>
        <span class="eng-client-frame-role">{NICK_TESTIMONIAL.role}</span>
      </span>
    </div>
  </div>
</Reveal>

---
import { site } from '@/config/site.ts'
import { absoluteUrl, documentTitle, pageMetadata, type PublicPageKey } from '@/lib/metadata.ts'

interface Props {
  /** Indexable route key, or `null` for the unindexed 404 document. */
  page: PublicPageKey | null
  /** Page title used when there is no page key (the 404 document). */
  title?: string
}

const { page, title }: Props = Astro.props

// Tag order, values and attribute sets mirror the production Next head
// exactly, so the parity manifest compares byte for byte. The only recorded
// departures are `og:locale` (`en_AU`, plan D-12) and Next's dropped
// `next-size-adjust` marker.
//
// The 404 document takes the root layout's shape: its own composed title and a
// `noindex` marker, but no canonical, and the site-level social values that the
// Next root layout published for any route without its own metadata.
const documentName = page ? documentTitle(page) : `${title}${site.titleSeparator}${site.name}`
const socialTitle = page ? documentName : site.title
const description = page ? pageMetadata[page].description : site.description
const canonical = page ? absoluteUrl(pageMetadata[page].route) : undefined
const socialUrl = page ? canonical : `${site.siteUrl}/`
const ogImage = absoluteUrl(site.ogImage)
---

<title>{documentName}</title>
<meta name="description" content={description} />
<meta name="robots" content={page ? 'index, follow' : 'noindex'} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={socialUrl} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.openGraphLocale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(site.ogImageWidth)} />
<meta property="og:image:height" content={String(site.ogImageHeight)} />
<meta property="og:image:alt" content={site.ogImageAlt} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{page && <meta name="twitter:image:alt" content={site.ogImageAlt} />}
<link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
<link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" type="image/png" />

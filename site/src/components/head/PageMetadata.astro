---
import { site } from '@/config/site.ts'
import { absoluteUrl, documentTitle, pageMetadata, type PublicPageKey } from '@/lib/metadata.ts'

interface Props {
  /** Indexable route key, or `null` for the unindexed 404 document. */
  page: PublicPageKey | null
  /** Title used when there is no page key (the 404 document). */
  title?: string
  /** Description used when there is no page key. */
  description?: string
}

const { page, title, description } = Astro.props

// Tag order, values and attribute sets mirror the production Next head
// exactly, so the parity manifest compares byte for byte. The only recorded
// departures are `og:locale` (`en_AU`, plan D-12) and Next's dropped
// `next-size-adjust` meta.
const resolvedTitle = page ? documentTitle(page) : (title ?? site.title)
const resolvedDescription = page ? pageMetadata[page].description : (description ?? site.description)
const canonical = page ? absoluteUrl(pageMetadata[page].route) : undefined
const ogImage = absoluteUrl(site.ogImage)
---

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
{page && <meta name="robots" content="index, follow" />}
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.openGraphLocale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(site.ogImageWidth)} />
<meta property="og:image:height" content={String(site.ogImageHeight)} />
<meta property="og:image:alt" content={site.ogImageAlt} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={site.ogImageAlt} />
<link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
<link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" type="image/png" />
